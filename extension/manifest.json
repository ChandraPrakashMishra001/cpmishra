{
  "manifest_version": 3,
  "name": "Amanai Voice Navigator",
  "version": "1.0.0",
  "description": "Voice-powered AI assistant — navigate the internet, read pages, and train custom skills using Gemini 3.",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": ["https://kkiqgaxtfeswzfmqixfm.supabase.co/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amanai Voice Navigator",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+A", "mac": "Command+Shift+A" },
      "description": "Open Amanai Voice Navigator"
    }
  }
}
